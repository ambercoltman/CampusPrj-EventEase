@model List<Venues>
@if(TempData["ErrorMessage"] != null)
{
	<div class="alert aert-danger">
		@TempData["ErrorMessage"]
	</div>
}
<h2 class="text-center mt-4">🏦VENUES🏦</h2>

<div class="container mt-3">
	<div class="row">
		@foreach (var Venues in Model)
		{
			<div class="col-md-4 mb-4">
				<div class="card shadow-sm text-center">
					<img src="@Venues.ImageUrl" class="card-img-top img-fluid rounded" alt="@Venues.VenueName">
					<div class="card-body">
						<h5 class="card-title">@Venues.VenueName</h5>
						<p class="card-text"><strong>Location:</strong> @Venues.Location</p>
						<p class="card-text"><strong>Capacity:</strong> @Venues.Capacity</p>
						<p class="card-text"><strong>Availability:</strong> @Venues.IsAvailable</p>
						<a asp-action="Delete" asp-route-id="@Venues.Id" method="post" class="btn btn-danger">Delete</a>
					</div>
				</div>
			</div>
		}
	</div>
</div>

<!-- Venue Upload Form-->
<div class="container mt-4 p-4 bg-light rounded">
	<h4 class="text-center">Add a new Venue</h4>
	<form asp-action="Create" method="post" enctype="multipart/form-data" class="p-3">
		<div class="mb-3">
			<label class="form-label">Upload Image</label>
			<input type="file" name="imageFile" class="form-control" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Venue Name</label>
			<input type="text" name="VenueName" placeholder="Enter the venue name" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Venue Location</label>
			<input type="text" name="Location" placeholder="Enter the venue location" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Venue Capacity</label>
			<input type="number" name="Capacity" placeholder="Enter the venue capacity" required />
		</div>
		<div class="mb-3">
			<label class="form-label">Venue Availability</label>
			<input type="number" name="Capacity" placeholder="Enter if the venue is available" required />
		</div>

		<button typeof="submit" class="btn btn-success w-100">Add Venue</button>
		</form>
</div>

